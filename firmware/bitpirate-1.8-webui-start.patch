@@ -845,6 +846,36 @@ void WifiController::handleWebUi(const TerminalCommand &)
     }
 }
 
+/*
+Web Interface: restart into WiFi Connect for one boot
+*/
+void WifiController::handleWebUiStart()
+{
+    if (state.getTerminalMode() == TerminalTypeEnum::WiFiClient) {
+        terminalView.println("WiFi Web UI: Already running at http://" + wifiService.getLocalIP());
+        return;
+    }
+
+    nvsService.open();
+    std::string ssid = nvsService.getString(state.getNvsSsidField());
+    std::string password = nvsService.getString(state.getNvsPasswordField());
+    if (ssid.empty() || password.empty()) {
+        nvsService.close();
+        terminalView.println("WiFi Web UI: No network saved yet. Use connect first.");
+        return;
+    }
+    nvsService.saveOneShotWebCli();
+    nvsService.close();
+
+    terminalView.println("WiFi Web UI: Restarting into WiFi Connect on " + ssid + "...");
+    if (wifiService.isConnected()) {
+        terminalView.println("WiFi Web UI: http://" + wifiService.getLocalIP() + " in about 10 seconds");
+    }
+    terminalView.println("WiFi Web UI: Reset the board to come back to USB serial.");
+    utilityService.sleepMs(300); // let the lines reach the host
+    utilityService.restart();
+}
+
