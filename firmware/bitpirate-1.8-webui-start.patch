+void NvsService::saveOneShotWebCli() {
+    preferences.putBool(ONE_SHOT_WEBCLI_KEY, true);
+}
+
+bool NvsService::consumeOneShotWebCli() {
+    bool requested = preferences.getBool(ONE_SHOT_WEBCLI_KEY, false);
+    if (requested) {
+        preferences.remove(ONE_SHOT_WEBCLI_KEY);
+    }
+    return requested;
+}
