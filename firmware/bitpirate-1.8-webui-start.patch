 }
 
+void saveCredentials(WifiFixture& fixture) {
+    auto& state = GlobalState::getInstance();
+    fixture.nvs.values[state.getNvsSsidField()] = "LabNet";
+    fixture.nvs.values[state.getNvsPasswordField()] = "secret";
+}
+
+void test_webui_start_with_saved_network_restarts_into_web_cli() {
+    WifiFixture fixture;
+    GlobalState::getInstance().setTerminalMode(TerminalTypeEnum::SerialPort);
+    saveCredentials(fixture);
+    fixture.wifi.connected = true;
+    fixture.wifi.localIp = "192.168.1.80";
+
+    fixture.controller.handleCommand(TerminalCommand("webui", "start", ""));
+
+    TEST_ASSERT_TRUE(fixture.nvs.oneShotWebCli);
+    TEST_ASSERT_EQUAL_UINT32(1, fixture.utility.restartCalls);
+    TEST_ASSERT_TRUE(fixture.view.contains("Restarting into WiFi Connect on LabNet"));
+    TEST_ASSERT_TRUE(fixture.view.contains("http://192.168.1.80"));
+}
+
+void test_webui_start_without_saved_network_does_not_restart() {
+    WifiFixture fixture;
+    GlobalState::getInstance().setTerminalMode(TerminalTypeEnum::SerialPort);
+
+    fixture.controller.handleCommand(TerminalCommand("webui", "start", ""));
+
+    TEST_ASSERT_FALSE(fixture.nvs.oneShotWebCli);
+    TEST_ASSERT_EQUAL_UINT32(0, fixture.utility.restartCalls);
+    TEST_ASSERT_TRUE(fixture.view.contains("No network saved yet"));
+}
+
+void test_webui_without_start_does_not_restart() {
+    WifiFixture fixture;
+    GlobalState::getInstance().setTerminalMode(TerminalTypeEnum::SerialPort);
+    saveCredentials(fixture);
+
+    fixture.controller.handleCommand(TerminalCommand("webui"));
+
+    TEST_ASSERT_FALSE(fixture.nvs.oneShotWebCli);
+    TEST_ASSERT_EQUAL_UINT32(0, fixture.utility.restartCalls);
+}
