+/*
+Bridge raw
+*/
+void UartController::handleBridgeRaw() {
+    if (GlobalState::getInstance().getTerminalMode() != TerminalTypeEnum::SerialPort) {
+        terminalView.println("Uart Bridge raw: needs the USB serial terminal (not Wi-Fi).\n");
+        return;
+    }
+
+    terminalView.println("Uart Bridge raw: binary-safe. Press [ANY ESP32 BUTTON] to stop.\n");
+    while (true) {
+        // UART -> host, byte for byte (print(uint8_t) writes the raw byte)
+        while (uartService.available()) {
+            terminalView.print(static_cast<uint8_t>(uartService.read()));
+        }
+
+        // Host -> UART; 0x00 is data here, not "no key"
+        uint8_t b;
+        while (terminalInput.readByte(b)) {
+            uartService.write(static_cast<char>(b));
+        }
+
+        // Device button stops the bridge, as in the text bridge
+        if (deviceInput.readChar() != KEY_NONE) {
+            terminalView.println("\r\nUart Bridge: Stopped by user.\n");
+            break;
+        }
+    }
+}
