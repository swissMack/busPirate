+void test_bridge_raw_passes_zero_bytes_in_both_directions() {
+    UartControllerFixture fixture;
+    fixture.uartService.queueRx(std::string("\x00\x41", 2));
+    fixture.terminalInput.queueReadByte(0x00);
+    fixture.terminalInput.queueReadByte(0xC0);
+    fixture.deviceInput.queueReadChar(KEY_NONE);
+    fixture.deviceInput.queueReadChar('\n');
+
+    fixture.controller.handleCommand(TerminalCommand("bridge", "raw", ""));
+
+    // FakeTerminalView renders print(uint8_t) as its decimal value.
+    bool sawZero = false, sawA = false;
+    for (const auto& call : fixture.view.printCalls) {
+        if (call == "0") sawZero = true;
+        if (call == "65") sawA = true;
+    }
+    TEST_ASSERT_TRUE(sawZero);
+    TEST_ASSERT_TRUE(sawA);
+    TEST_ASSERT_TRUE(fixture.uartService.wrote(std::string(1, '\0')));
+    TEST_ASSERT_TRUE(fixture.uartService.wrote(std::string(1, '\xC0')));
+    TEST_ASSERT_TRUE(fixture.view.contains("Uart Bridge: Stopped by user."));
+}
+
+void test_bridge_raw_refuses_when_terminal_is_not_usb_serial() {
+    UartControllerFixture fixture;
+    GlobalState::getInstance().setTerminalMode(TerminalTypeEnum::WiFiClient);
+    fixture.terminalInput.queueReadByte(0x55);
+
+    fixture.controller.handleCommand(TerminalCommand("bridge", "raw", ""));
+
+    TEST_ASSERT_TRUE(fixture.uartService.writes.empty());
+    TEST_ASSERT_TRUE(fixture.view.contains("USB serial"));
+}
