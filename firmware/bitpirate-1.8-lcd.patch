diff --git a/src/Boards/Common/Views/CompositeDeviceView.h b/src/Boards/Common/Views/CompositeDeviceView.h
new file mode 100644
index 00000000..c2df1618
--- /dev/null
+++ b/src/Boards/Common/Views/CompositeDeviceView.h
@@ -0,0 +1,59 @@
+#pragma once
+
+#include "Interfaces/IDeviceView.h"
+
+// Drives two views as one: every call goes to the primary, then to the
+// secondary. Anything that returns a value (SPI, screen, brightness) comes
+// from the primary. Used to put the RGB mode LED and the status LCD side by
+// side on the S3 DevKit.
+class CompositeDeviceView : public IDeviceView {
+public:
+    CompositeDeviceView(IDeviceView& primary, IDeviceView& secondary)
+        : first(primary), second(secondary) {}
+
+    void initialize() override { first.initialize(); second.initialize(); }
+    SPIClass& getSharedSpiInstance() override { return first.getSharedSpiInstance(); }
+    void* getScreen() override { return first.getScreen(); }
+    void logo() override { first.logo(); second.logo(); }
+    void welcome(TerminalTypeEnum& terminalType, std::string& terminalInfos) override {
+        first.welcome(terminalType, terminalInfos);
+        second.welcome(terminalType, terminalInfos);
+    }
+    void show(PinoutConfig& config) override { first.show(config); second.show(config); }
+    void loading() override { first.loading(); second.loading(); }
+    void adapterMode(const std::string& adapterName, const std::string& description,
+                     const std::vector<std::string>& details) override {
+        first.adapterMode(adapterName, description, details);
+        second.adapterMode(adapterName, description, details);
+    }
+    void clear() override { first.clear(); second.clear(); }
+    void drawLogicTrace(uint8_t pin, const std::vector<uint8_t>& buffer, uint8_t step) override {
+        first.drawLogicTrace(pin, buffer, step);
+        second.drawLogicTrace(pin, buffer, step);
+    }
+    void drawAnalogicTrace(uint8_t pin, const std::vector<uint8_t>& buffer, uint8_t step) override {
+        first.drawAnalogicTrace(pin, buffer, step);
+        second.drawAnalogicTrace(pin, buffer, step);
+    }
+    void drawWaterfall(const std::string& title, float startValue, float endValue, const char* unit,
+                       int rowIndex, int rowCount, int level) override {
+        first.drawWaterfall(title, startValue, endValue, unit, rowIndex, rowCount, level);
+        second.drawWaterfall(title, startValue, endValue, unit, rowIndex, rowCount, level);
+    }
+    void setRotation(uint8_t rotation) override { first.setRotation(rotation); second.setRotation(rotation); }
+    void setBrightness(uint8_t brightness) override { first.setBrightness(brightness); second.setBrightness(brightness); }
+    uint8_t getBrightness() override { return first.getBrightness(); }
+    void topBar(const std::string& title, bool submenu, bool searchBar) override {
+        first.topBar(title, submenu, searchBar);
+        second.topBar(title, submenu, searchBar);
+    }
+    void horizontalSelection(const std::vector<std::string>& options, uint16_t selectedIndex,
+                             const std::string& description1, const std::string& description2) override {
+        first.horizontalSelection(options, selectedIndex, description1, description2);
+        second.horizontalSelection(options, selectedIndex, description1, description2);
+    }
+
+private:
+    IDeviceView& first;
+    IDeviceView& second;
+};
diff --git a/src/Boards/Common/Views/Lcd1602.cpp b/src/Boards/Common/Views/Lcd1602.cpp
new file mode 100644
index 00000000..f3261ed9
--- /dev/null
+++ b/src/Boards/Common/Views/Lcd1602.cpp
@@ -0,0 +1,188 @@
+#include "Lcd1602.h"
+
+#include <Arduino.h>
+
+namespace {
+constexpr uint8_t RS = 0x01;
+constexpr uint8_t EN = 0x04;
+constexpr uint8_t BACKLIGHT = 0x08;
+constexpr uint8_t HALF_US = 5;
+}
+
+void Lcd1602::sdaHigh() { pinMode(sda, INPUT); }
+void Lcd1602::sdaLow() { digitalWrite(sda, LOW); pinMode(sda, OUTPUT); }
+void Lcd1602::sclHigh() { pinMode(scl, INPUT); }
+void Lcd1602::sclLow() { digitalWrite(scl, LOW); pinMode(scl, OUTPUT); }
+
+void Lcd1602::busFree() {
+    sdaHigh();
+    sclHigh();
+}
+
+bool Lcd1602::start() {
+    sdaHigh();
+    sclHigh();
+    delayMicroseconds(HALF_US);
+    sdaLow();
+    delayMicroseconds(HALF_US);
+    sclLow();
+    return true;
+}
+
+void Lcd1602::stop() {
+    sdaLow();
+    delayMicroseconds(HALF_US);
+    sclHigh();
+    delayMicroseconds(HALF_US);
+    sdaHigh();
+    delayMicroseconds(HALF_US);
+}
+
+bool Lcd1602::writeByteBus(uint8_t value) {
+    for (uint8_t i = 0; i < 8; i++) {
+        if (value & 0x80) sdaHigh(); else sdaLow();
+        value <<= 1;
+        delayMicroseconds(HALF_US);
+        sclHigh();
+        delayMicroseconds(HALF_US);
+        sclLow();
+    }
+    sdaHigh();                       // release for the ACK bit
+    delayMicroseconds(HALF_US);
+    sclHigh();
+    delayMicroseconds(HALF_US);
+    bool ack = digitalRead(sda) == LOW;
+    sclLow();
+    return ack;
+}
+
+uint8_t Lcd1602::readByteBus(bool ack) {
+    uint8_t value = 0;
+    sdaHigh();
+    for (uint8_t i = 0; i < 8; i++) {
+        delayMicroseconds(HALF_US);
+        sclHigh();
+        delayMicroseconds(HALF_US);
+        value = (value << 1) | (digitalRead(sda) ? 1 : 0);
+        sclLow();
+    }
+    if (ack) sdaLow(); else sdaHigh();
+    delayMicroseconds(HALF_US);
+    sclHigh();
+    delayMicroseconds(HALF_US);
+    sclLow();
+    sdaHigh();
+    return value;
+}
+
+bool Lcd1602::probe(uint8_t a) {
+    start();
+    bool ack = writeByteBus(a << 1);
+    stop();
+    return ack;
+}
+
+bool Lcd1602::sendPort(uint8_t value) {
+    start();
+    bool ok = writeByteBus(addr << 1);
+    ok = ok && writeByteBus(value);
+    stop();
+    return ok;
+}
+
+bool Lcd1602::readPort(uint8_t& value) {
+    start();
+    bool ok = writeByteBus((addr << 1) | 1);
+    if (ok) value = readByteBus(false);
+    stop();
+    return ok;
+}
+
+// Latches one nibble already placed on P4..P7 (plus RS/backlight bits).
+bool Lcd1602::pulse(uint8_t bits) {
+    bool ok = sendPort(bits | EN);
+    delayMicroseconds(1);            // E high >= 450 ns
+    ok = sendPort(bits & ~EN) && ok;
+    delayMicroseconds(50);           // most commands need > 37 us
+    return ok;
+}
+
+bool Lcd1602::sendNibble(uint8_t nibble, bool rs) {
+    return pulse(((nibble & 0x0F) << 4) | BACKLIGHT | (rs ? RS : 0));
+}
+
+bool Lcd1602::sendByte(uint8_t value, bool rs) {
+    bool ok = sendNibble(value >> 4, rs);
+    return sendNibble(value & 0x0F, rs) && ok;
+}
+
+bool Lcd1602::initLcd() {
+    delay(50);                       // power-up, > 40 ms
+    bool ok = sendPort(BACKLIGHT);
+    ok = sendNibble(0x3, false) && ok;
+    delay(5);                        // > 4.1 ms
+    ok = sendNibble(0x3, false) && ok;
+    delayMicroseconds(150);          // > 100 us
+    ok = sendNibble(0x3, false) && ok;
+    delayMicroseconds(150);
+    ok = sendNibble(0x2, false) && ok;   // switch to 4-bit
+    delayMicroseconds(150);
+    ok = sendByte(0x28, false) && ok;    // 4-bit, 2 lines, 5x8
+    ok = sendByte(0x0C, false) && ok;    // display on, no cursor
+    ok = sendByte(0x06, false) && ok;    // increment, no shift
+    ok = sendByte(0x01, false) && ok;    // clear
+    delay(2);                            // clear takes ~1.52 ms
+    return ok;
+}
+
+bool Lcd1602::begin(uint8_t sdaPin, uint8_t sclPin) {
+    sda = sdaPin;
+    scl = sclPin;
+    found = false;
+    busFree();
+    delayMicroseconds(HALF_US);
+    for (uint8_t a : {uint8_t(0x27), uint8_t(0x3F)}) {
+        if (probe(a)) {
+            addr = a;
+            found = initLcd();
+            return found;
+        }
+    }
+    return false;
+}
+
+bool Lcd1602::present() const { return found; }
+uint8_t Lcd1602::address() const { return addr; }
+
+bool Lcd1602::write(const LcdScreen& screen) {
+    if (!found) return false;
+    bool ok = true;
+    for (uint8_t row = 0; row < 2; row++) {
+        ok = sendByte(row == 0 ? 0x80 : 0xC0, false) && ok;   // set DDRAM address
+        const std::string& line = screen[row];
+        for (uint8_t i = 0; i < 16; i++) {
+            char c = i < line.size() ? line[i] : ' ';
+            ok = sendByte((uint8_t)c, true) && ok;
+        }
+    }
+    return ok;
+}
+
+uint32_t Lcd1602::selfTest(uint32_t rounds) {
+    if (!found) return rounds;
+    uint32_t bad = 0;
+    for (uint32_t i = 0; i < rounds; i++) {
+        // E low and RW low always; alternate data nibbles and RS. The LCD only
+        // latches on the E falling edge, so it ignores all of this.
+        uint8_t nibble = (i & 1) ? 0x5 : 0xA;
+        if (i & 2) nibble = (uint8_t)~nibble & 0x0F;
+        uint8_t pattern = (nibble << 4) | BACKLIGHT | ((i & 4) ? RS : 0);
+        uint8_t back = 0;
+        // P3 is masked out: on the FC-113 it drives an NPN base through a
+        // resistor, so the weak PCF8574 pull-up sags and P3 can read back 0.
+        if (!sendPort(pattern) || !readPort(back) ||
+            (back & ~BACKLIGHT) != (pattern & ~BACKLIGHT)) bad++;
+    }
+    sendPort(BACKLIGHT);             // restore idle: E low, backlight on
+    return bad;
+}
diff --git a/src/Boards/Common/Views/Lcd1602.h b/src/Boards/Common/Views/Lcd1602.h
new file mode 100644
index 00000000..c235fc20
--- /dev/null
+++ b/src/Boards/Common/Views/Lcd1602.h
@@ -0,0 +1,50 @@
+#pragma once
+
+#include <stdint.h>
+
+#include "Transformers/LcdScreenTransformer.h"
+
+// 16x2 HD44780 LCD behind an FC-113 PCF8574 I2C backpack, driven by bit-banged
+// I2C on two plain GPIOs. It deliberately avoids Wire/Wire1: both hardware I2C
+// controllers belong to the I2C mode and the sensors.
+//
+// Open drain is emulated: high = pin as INPUT (external 3V3 pull-ups),
+// low = OUTPUT driving LOW. About 5 us per half period (under 100 kHz).
+//
+// PCF8574 bits (FC-113): P0 RS, P1 RW (always 0), P2 E, P3 backlight (always
+// on), P4..P7 D4..D7.
+class Lcd1602 {
+public:
+    // Probes 0x27 then 0x3F and initialises the LCD. False = no backpack.
+    bool begin(uint8_t sdaPin, uint8_t sclPin);
+    bool present() const;
+    // Whole-screen write. False on any NACK.
+    bool write(const LcdScreen& screen);
+    // Writes and reads back a pattern on the PCF8574 port with E low, so the
+    // LCD itself is untouched. Returns mismatches plus NACKs.
+    uint32_t selfTest(uint32_t rounds);
+    uint8_t address() const;
+
+private:
+    void busFree();
+    void sdaHigh();
+    void sdaLow();
+    void sclHigh();
+    void sclLow();
+    bool start();
+    void stop();
+    bool writeByteBus(uint8_t value);   // true = ACK
+    uint8_t readByteBus(bool ack);
+    bool probe(uint8_t addr);
+    bool sendPort(uint8_t value);
+    bool readPort(uint8_t& value);
+    bool pulse(uint8_t nibbleBits);
+    bool sendNibble(uint8_t nibble, bool rs);
+    bool sendByte(uint8_t value, bool rs);
+    bool initLcd();
+
+    uint8_t sda = 0;
+    uint8_t scl = 0;
+    uint8_t addr = 0;
+    bool found = false;
+};
diff --git a/src/Boards/Common/Views/LcdView.cpp b/src/Boards/Common/Views/LcdView.cpp
new file mode 100644
index 00000000..7da48782
--- /dev/null
+++ b/src/Boards/Common/Views/LcdView.cpp
@@ -0,0 +1,114 @@
+#include "LcdView.h"
+
+#include <Arduino.h>
+#include <stdio.h>
+
+#include "States/GlobalState.h"
+
+namespace {
+constexpr uint32_t PAGE_MS = 3000;
+constexpr uint32_t SPLASH_MS = 2000;
+
+// Holds the mutex for the lifetime of the scope.
+class Lock {
+public:
+    explicit Lock(SemaphoreHandle_t m) : m(m) { xSemaphoreTake(m, portMAX_DELAY); }
+    ~Lock() { xSemaphoreGive(m); }
+private:
+    SemaphoreHandle_t m;
+};
+}
+
+LcdView::LcdView(uint8_t sda, uint8_t scl) : sda(sda), scl(scl) {}
+
+void LcdView::initialize() {
+    // Called twice at boot (board init, then the dispatcher): once is enough,
+    // so the splash is shown a single time and the second call costs nothing.
+    if (initialized) return;
+    initialized = true;
+
+    if (!lcd.begin(sda, scl)) return;
+
+    mutex = xSemaphoreCreateMutex();
+    timer = xTimerCreate("lcdpage", pdMS_TO_TICKS(PAGE_MS), pdTRUE, this, onPageTimer);
+    if (mutex == nullptr || timer == nullptr) return;
+    ready = true;
+
+    Lock lock(mutex);
+
+#ifdef LCD_SELFTEST
+    {
+        uint32_t errors = lcd.selfTest(LCD_SELFTEST);
+        printf("LCD selftest addr 0x%02X rounds %u errors %u\n",
+               lcd.address(), (unsigned)LCD_SELFTEST, (unsigned)errors);
+        char line2[17];
+        snprintf(line2, sizeof(line2), "errors %u", (unsigned)errors);
+        LcdScreen result = LcdScreenTransformer::adapter("LCD selftest");
+        result[1] = LcdScreenTransformer::adapter(line2)[0];
+        showScreen(result);
+        vTaskDelay(pdMS_TO_TICKS(5000));
+    }
+#endif
+
+    showScreen(LcdScreenTransformer::splash(GlobalState::getInstance().getVersion()));
+    vTaskDelay(pdMS_TO_TICKS(SPLASH_MS));
+}
+
+void LcdView::showScreen(const LcdScreen& screen) {
+    lcd.write(screen);
+}
+
+void LcdView::stopPaging() {
+    xTimerStop(timer, 0);
+    pages.clear();
+    pageIndex = 0;
+}
+
+void LcdView::welcome(TerminalTypeEnum& terminalType, std::string& terminalInfos) {
+    if (!ready) return;
+    Lock lock(mutex);
+    stopPaging();
+    showScreen(LcdScreenTransformer::connection(terminalType, terminalInfos));
+}
+
+void LcdView::show(PinoutConfig& config) {
+    if (!ready) return;
+    std::vector<LcdScreen> next = LcdScreenTransformer::pinPages(config);
+
+    Lock lock(mutex);
+    stopPaging();
+    if (next.empty()) {
+        GlobalState& state = GlobalState::getInstance();
+        showScreen(LcdScreenTransformer::connection(state.getTerminalMode(), state.getTerminalIp()));
+        return;
+    }
+    pages = std::move(next);
+    showScreen(pages[0]);
+    if (pages.size() > 1) {
+        xTimerStart(timer, 0);
+    }
+}
+
+void LcdView::adapterMode(const std::string& adapterName, const std::string&,
+                          const std::vector<std::string>&) {
+    if (!ready) return;
+    Lock lock(mutex);
+    stopPaging();
+    showScreen(LcdScreenTransformer::adapter(adapterName));
+}
+
+void LcdView::clear() {}
+
+void LcdView::onPageTimer(TimerHandle_t t) {
+    static_cast<LcdView*>(pvTimerGetTimerID(t))->advancePage();
+}
+
+void LcdView::advancePage() {
+    // Short wait: if a mode change holds the lock, it is about to stop us anyway.
+    if (xSemaphoreTake(mutex, pdMS_TO_TICKS(100)) != pdTRUE) return;
+    if (pages.size() > 1) {
+        pageIndex = (pageIndex + 1) % pages.size();
+        showScreen(pages[pageIndex]);
+    }
+    xSemaphoreGive(mutex);
+}
diff --git a/src/Boards/Common/Views/LcdView.h b/src/Boards/Common/Views/LcdView.h
new file mode 100644
index 00000000..ac65a28c
--- /dev/null
+++ b/src/Boards/Common/Views/LcdView.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <vector>
+
+#include "Boards/Common/Views/Lcd1602.h"
+#include "Boards/Common/Views/NoScreenDeviceView.h"
+
+#include <freertos/FreeRTOS.h>
+#include <freertos/semphr.h>
+#include <freertos/timers.h>
+
+// Status LCD: shows the boot splash, the connection (Wi-Fi IP or USB), the
+// current mode with its pins (paged every 3 s when more than four), or the
+// adapter name. If no backpack answers, every method returns immediately and
+// the firmware behaves exactly as without the LCD.
+//
+// All Lcd1602 access and all page state sit behind one mutex, so a mode change
+// can never interleave with the paging timer and tear a screen.
+class LcdView : public NoScreenDeviceView {
+public:
+    LcdView(uint8_t sda, uint8_t scl);
+
+    void initialize() override;
+    void welcome(TerminalTypeEnum& terminalType, std::string& terminalInfos) override;
+    void show(PinoutConfig& config) override;
+    void adapterMode(const std::string& adapterName, const std::string& description,
+                     const std::vector<std::string>& details) override;
+    // Deliberately a no-op: keep the last screen.
+    void clear() override;
+
+private:
+    static void onPageTimer(TimerHandle_t timer);
+    void advancePage();
+    void showScreen(const LcdScreen& screen);   // caller holds the mutex
+    void stopPaging();                          // caller holds the mutex
+
+    uint8_t sda;
+    uint8_t scl;
+    Lcd1602 lcd;
+    bool initialized = false;   // initialize() ran once (splash shown once)
+    bool ready = false;         // backpack found
+    SemaphoreHandle_t mutex = nullptr;
+    TimerHandle_t timer = nullptr;
+    std::vector<LcdScreen> pages;
+    size_t pageIndex = 0;
+};
