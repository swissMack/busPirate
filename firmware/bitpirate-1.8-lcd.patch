--- /dev/null
+++ b/src/Transformers/LcdScreenTransformer.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <array>
+#include <string>
+#include <vector>
+
+#include "Enums/TerminalTypeEnum.h"
+#include "Models/PinoutConfig.h"
+
+// Two lines of exactly 16 characters each.
+using LcdScreen = std::array<std::string, 2>;
+
+// Pure text layout for the 16x2 status LCD. No hardware, no Arduino headers.
+class LcdScreenTransformer {
+public:
+    static LcdScreen splash(const std::string& version);
+    static LcdScreen connection(TerminalTypeEnum type, const std::string& ip);
+    static LcdScreen adapter(const std::string& name);
+
+    // Empty vector = the mode has no pins; the caller shows connection().
+    static std::vector<LcdScreen> pinPages(const PinoutConfig& config);
+};
diff --git a/test/Transformers/test_LcdScreenTransformer.cpp b/test/Transformers/test_LcdScreenTransformer.cpp
new file mode 100644
index 00000000..2bb93e9f
--- /dev/null
+++ b/test/Transformers/test_LcdScreenTransformer.cpp
@@ -0,0 +1,161 @@
+#include <unity.h>
+
+#include "Transformers/LcdScreenTransformer.h"
+
+namespace lcd_screen_tests {
+
+PinoutConfig cfg(const std::string& mode, const std::vector<std::string>& mappings) {
+    PinoutConfig c;
+    c.setMode(mode);
+    c.setMappings(mappings);
+    return c;
+}
+
+void expectScreen(const char* l1, const char* l2, const LcdScreen& s) {
+    TEST_ASSERT_EQUAL_STRING(l1, s[0].c_str());
+    TEST_ASSERT_EQUAL_STRING(l2, s[1].c_str());
+    TEST_ASSERT_EQUAL_UINT32(16, s[0].size());
+    TEST_ASSERT_EQUAL_UINT32(16, s[1].size());
+}
+
+void test_connection_wifi() {
+    expectScreen("Bit Pirate WiFi ", "192.168.1.42    ",
+                 LcdScreenTransformer::connection(TerminalTypeEnum::WiFiClient, "192.168.1.42"));
+}
+
+void test_connection_ap() {
+    auto s = LcdScreenTransformer::connection(TerminalTypeEnum::WiFiAp, "192.168.4.1");
+    TEST_ASSERT_EQUAL_STRING("Bit Pirate WiFi ", s[0].c_str());
+    TEST_ASSERT_EQUAL_STRING("192.168.4.1     ", s[1].c_str());
+}
+
+void test_connection_serial() {
+    expectScreen("Bit Pirate USB  ", "                ",
+                 LcdScreenTransformer::connection(TerminalTypeEnum::SerialPort, ""));
+}
+
+void test_connection_standalone_and_none_like_serial() {
+    expectScreen("Bit Pirate USB  ", "                ",
+                 LcdScreenTransformer::connection(TerminalTypeEnum::Standalone, "1.2.3.4"));
+    expectScreen("Bit Pirate USB  ", "                ",
+                 LcdScreenTransformer::connection(TerminalTypeEnum::None, ""));
+}
+
+void test_connection_zero_ip() {
+    auto a = LcdScreenTransformer::connection(TerminalTypeEnum::WiFiClient, "0.0.0.0");
+    auto b = LcdScreenTransformer::connection(TerminalTypeEnum::SerialPort, "");
+    TEST_ASSERT_EQUAL_STRING(b[0].c_str(), a[0].c_str());
+    TEST_ASSERT_EQUAL_STRING(b[1].c_str(), a[1].c_str());
+}
+
+void test_splash() {
+    expectScreen("Bit Pirate      ", "1.8             ", LcdScreenTransformer::splash("1.8"));
+}
+
+void test_adapter() {
+    expectScreen("flashrom serprog", "                ", LcdScreenTransformer::adapter("flashrom serprog"));
+}
+
+void test_adapter_truncates() {
+    auto s = LcdScreenTransformer::adapter("a very long adapter name");
+    TEST_ASSERT_EQUAL_STRING("a very long adap", s[0].c_str());
+}
+
+void test_i2c() {
+    auto p = LcdScreenTransformer::pinPages(cfg("I2C", {"SDA GPIO 15", "SCL GPIO 16", "FREQ 100000"}));
+    TEST_ASSERT_EQUAL_UINT32(1, p.size());
+    expectScreen("I2C   SDA  IO15 ", "GND   SCL  IO16 ", p[0]);
+}
+
+void test_onewire() {
+    auto p = LcdScreenTransformer::pinPages(cfg("1WIRE", {"DATA GPIO 6"}));
+    TEST_ASSERT_EQUAL_UINT32(1, p.size());
+    expectScreen("1WIRE DATA IO6  ", "GND             ", p[0]);
+}
+
+void test_spi_four() {
+    auto p = LcdScreenTransformer::pinPages(
+        cfg("SPI", {"MOSI GPIO 13", "MISO GPIO 10", "CLK GPIO 12", "CS GPIO 11"}));
+    TEST_ASSERT_EQUAL_UINT32(1, p.size());
+    expectScreen("MO IO13 MI IO10 ", "CK IO12 CS IO11 ", p[0]);
+}
+
+void test_three_pins() {
+    auto p = LcdScreenTransformer::pinPages(cfg("2WIRE", {"IO GPIO 11", "CLK GPIO 12", "RST GPIO 14"}));
+    TEST_ASSERT_EQUAL_UINT32(1, p.size());
+    expectScreen("IO IO11 CK IO12 ", "RS IO14         ", p[0]);
+}
+
+void test_abbreviations() {
+    auto p = LcdScreenTransformer::pinPages(
+        cfg("X", {"SCK GPIO 1", "SCLK GPIO 2", "CLOCK GPIO 3", "CSN GPIO 4",
+                  "SDA GPIO 5", "SCL GPIO 6", "DATA GPIO 7", "DI GPIO 8",
+                  "DO GPIO 9", "TX GPIO 10"}));
+    TEST_ASSERT_EQUAL_UINT32(3, p.size());
+    expectScreen("CK IO1  CK IO2  ", "CK IO3  CS IO4  ", p[0]);
+    expectScreen("DA IO5  CL IO6  ", "DI IO7  DI IO8  ", p[1]);
+    expectScreen("DO IO9  TX IO10 ", "                ", p[2]);
+}
+
+void test_five_pins_two_pages() {
+    auto p = LcdScreenTransformer::pinPages(
+        cfg("JTAG", {"SCAN GPIO 1", "SCAN GPIO 2", "SCAN GPIO 3", "SCAN GPIO 4", "SCAN GPIO 5"}));
+    TEST_ASSERT_EQUAL_UINT32(2, p.size());
+    expectScreen("SC IO5          ", "                ", p[1]);
+    expectScreen("SC IO1  SC IO2  ", "SC IO3  SC IO4  ", p[0]);
+}
+
+void test_multiword_two_pins_use_last_word() {
+    auto p = LcdScreenTransformer::pinPages(cfg("RFID", {"RFID SDA GPIO 15", "RFID SCL GPIO 16"}));
+    TEST_ASSERT_EQUAL_UINT32(1, p.size());
+    expectScreen("RFID  SDA  IO15 ", "GND   SCL  IO16 ", p[0]);
+}
+
+void test_multiword_many_pins_use_last_word() {
+    auto p = LcdScreenTransformer::pinPages(
+        cfg("INFRARED", {"IR TX GPIO 4", "IR RX GPIO 5", "CLK GPIO 12"}));
+    TEST_ASSERT_EQUAL_UINT32(1, p.size());
+    TEST_ASSERT_EQUAL_STRING("TX IO4  RX IO5  ", p[0][0].c_str());
+}
+
+void test_hduart_single_word_slash_name() {
+    auto p = LcdScreenTransformer::pinPages(cfg("HDUART", {"RX/TX GPIO 17"}));
+    TEST_ASSERT_EQUAL_UINT32(1, p.size());
+    TEST_ASSERT_EQUAL_STRING("HDUAR RX/T IO17 ", p[0][0].c_str());
+}
+
+void test_long_mode_name() {
+    auto p = LcdScreenTransformer::pinPages(cfg("INFRARED", {"TX GPIO 4"}));
+    TEST_ASSERT_EQUAL_UINT32(1, p.size());
+    expectScreen("INFRA TX   IO4  ", "GND             ", p[0]);
+}
+
+void test_no_pins() {
+    TEST_ASSERT_TRUE(LcdScreenTransformer::pinPages(cfg("LED", {"LED COUNT 16", "apa102"})).empty());
+    TEST_ASSERT_TRUE(LcdScreenTransformer::pinPages(cfg("HIZ", {})).empty());
+}
+
+}  // namespace lcd_screen_tests
+
+void runLcdScreenTransformerTests() {
+    using namespace lcd_screen_tests;
+    RUN_TEST(test_connection_wifi);
+    RUN_TEST(test_connection_ap);
+    RUN_TEST(test_connection_serial);
+    RUN_TEST(test_connection_standalone_and_none_like_serial);
+    RUN_TEST(test_connection_zero_ip);
+    RUN_TEST(test_splash);
+    RUN_TEST(test_adapter);
+    RUN_TEST(test_adapter_truncates);
+    RUN_TEST(test_i2c);
+    RUN_TEST(test_onewire);
+    RUN_TEST(test_spi_four);
+    RUN_TEST(test_three_pins);
+    RUN_TEST(test_abbreviations);
+    RUN_TEST(test_five_pins_two_pages);
+    RUN_TEST(test_multiword_two_pins_use_last_word);
+    RUN_TEST(test_multiword_many_pins_use_last_word);
+    RUN_TEST(test_hduart_single_word_slash_name);
+    RUN_TEST(test_long_mode_name);
+    RUN_TEST(test_no_pins);
+}
diff --git a/test/Views/test_CompositeDeviceView.cpp b/test/Views/test_CompositeDeviceView.cpp
new file mode 100644
index 00000000..cb6aeb06
--- /dev/null
+++ b/test/Views/test_CompositeDeviceView.cpp
@@ -0,0 +1,93 @@
+#include <unity.h>
+
+#include "../Views/FakeDeviceView.h"
+#include "Boards/Common/Views/CompositeDeviceView.h"
+
+namespace composite_view_tests {
+
+// Records the calls the composite must forward; everything else is inherited
+// from FakeDeviceView.
+class RecordingView final : public IDeviceView {
+public:
+    explicit RecordingView(uint8_t brightness) : brightnessValue(brightness) {}
+
+    SPIClass spi;
+    int initCount = 0;
+    int clearCount = 0;
+    std::vector<std::string> modes;
+    std::vector<std::string> welcomeInfos;
+
+    void initialize() override { initCount++; }
+    SPIClass& getSharedSpiInstance() override { return spi; }
+    void* getScreen() override { return nullptr; }
+    void logo() override {}
+    void welcome(TerminalTypeEnum&, std::string& infos) override { welcomeInfos.push_back(infos); }
+    void show(PinoutConfig& config) override { modes.push_back(config.getMode()); }
+    void loading() override {}
+    void adapterMode(const std::string&, const std::string&, const std::vector<std::string>&) override {}
+    void clear() override { clearCount++; }
+    void drawLogicTrace(uint8_t, const std::vector<uint8_t>&, uint8_t) override {}
+    void drawAnalogicTrace(uint8_t, const std::vector<uint8_t>&, uint8_t) override {}
+    void drawWaterfall(const std::string&, float, float, const char*, int, int, int) override {}
+    void setRotation(uint8_t) override {}
+    void setBrightness(uint8_t b) override { brightnessValue = b; }
+    uint8_t getBrightness() override { return brightnessValue; }
+    void topBar(const std::string&, bool, bool) override {}
+    void horizontalSelection(const std::vector<std::string>&, uint16_t, const std::string&, const std::string&) override {}
+
+private:
+    uint8_t brightnessValue;
+};
+
+void test_composite_forwards_show_to_both() {
+    RecordingView a(24), b(99);
+    CompositeDeviceView composite(a, b);
+    PinoutConfig cfg;
+    cfg.setMode("I2C");
+    composite.show(cfg);
+    TEST_ASSERT_EQUAL_UINT32(1, a.modes.size());
+    TEST_ASSERT_EQUAL_UINT32(1, b.modes.size());
+    TEST_ASSERT_EQUAL_STRING("I2C", a.modes[0].c_str());
+    TEST_ASSERT_EQUAL_STRING("I2C", b.modes[0].c_str());
+}
+
+void test_composite_forwards_welcome_to_both() {
+    RecordingView a(24), b(99);
+    CompositeDeviceView composite(a, b);
+    TerminalTypeEnum type = TerminalTypeEnum::WiFiClient;
+    std::string infos = "192.168.1.42";
+    composite.welcome(type, infos);
+    TEST_ASSERT_EQUAL_UINT32(1, a.welcomeInfos.size());
+    TEST_ASSERT_EQUAL_UINT32(1, b.welcomeInfos.size());
+    TEST_ASSERT_EQUAL_STRING("192.168.1.42", b.welcomeInfos[0].c_str());
+}
+
+void test_composite_forwards_initialize_and_clear() {
+    RecordingView a(24), b(99);
+    CompositeDeviceView composite(a, b);
+    composite.initialize();
+    composite.clear();
+    TEST_ASSERT_EQUAL_INT(1, a.initCount);
+    TEST_ASSERT_EQUAL_INT(1, b.initCount);
+    TEST_ASSERT_EQUAL_INT(1, a.clearCount);
+    TEST_ASSERT_EQUAL_INT(1, b.clearCount);
+}
+
+void test_composite_brightness_from_primary() {
+    RecordingView a(24), b(99);
+    CompositeDeviceView composite(a, b);
+    TEST_ASSERT_EQUAL_UINT8(24, composite.getBrightness());
+    composite.setBrightness(7);
+    TEST_ASSERT_EQUAL_UINT8(7, composite.getBrightness());
+    TEST_ASSERT_EQUAL_UINT8(7, b.getBrightness());
+}
+
+}  // namespace composite_view_tests
+
+void runCompositeDeviceViewTests() {
+    using namespace composite_view_tests;
+    RUN_TEST(test_composite_forwards_show_to_both);
+    RUN_TEST(test_composite_forwards_welcome_to_both);
+    RUN_TEST(test_composite_forwards_initialize_and_clear);
+    RUN_TEST(test_composite_brightness_from_primary);
+}
