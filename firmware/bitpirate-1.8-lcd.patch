diff --git a/src/Transformers/LcdScreenTransformer.cpp b/src/Transformers/LcdScreenTransformer.cpp
new file mode 100644
index 00000000..ffd71f38
--- /dev/null
+++ b/src/Transformers/LcdScreenTransformer.cpp
@@ -0,0 +1,98 @@
+#include "LcdScreenTransformer.h"
+
+namespace {
+
+constexpr size_t kWidth = 16;
+
+// Cut to `width`, then pad with spaces to `width`.
+std::string fit(const std::string& s, size_t width) {
+    std::string out = s.substr(0, width);
+    out.resize(width, ' ');
+    return out;
+}
+
+struct Pin {
+    std::string name;
+    std::string number;
+};
+
+std::vector<Pin> parsePins(const PinoutConfig& config) {
+    static const std::string marker = " GPIO ";
+    std::vector<Pin> pins;
+    for (const auto& m : config.getMappings()) {
+        size_t pos = m.find(marker);
+        if (pos == std::string::npos || pos == 0) continue;
+        std::string num = m.substr(pos + marker.size());
+        if (num.empty()) continue;
+        bool digits = true;
+        for (char c : num) {
+            if (c < '0' || c > '9') { digits = false; break; }
+        }
+        if (!digits) continue;
+        std::string name = m.substr(0, pos);
+        size_t sp = name.rfind(' ');
+        if (sp != std::string::npos) name = name.substr(sp + 1);  // multi-word: last word
+        if (name.empty()) continue;
+        pins.push_back({name, num});
+    }
+    return pins;
+}
+
+std::string abbreviate(const std::string& name) {
+    if (name == "MOSI") return "MO";
+    if (name == "MISO") return "MI";
+    if (name == "CLK" || name == "SCK" || name == "SCLK" || name == "CLOCK") return "CK";
+    if (name == "CS" || name == "CSN") return "CS";
+    if (name == "SDA") return "DA";
+    if (name == "SCL") return "CL";
+    if (name == "DATA" || name == "DI") return "DI";
+    if (name == "DO") return "DO";
+    return name.substr(0, 2);
+}
+
+std::string slot(const Pin& p) {
+    return fit(abbreviate(p.name) + " IO" + p.number, 8);
+}
+
+}  // namespace
+
+LcdScreen LcdScreenTransformer::splash(const std::string& version) {
+    return {fit("Bit Pirate", kWidth), fit(version, kWidth)};
+}
+
+LcdScreen LcdScreenTransformer::connection(TerminalTypeEnum type, const std::string& ip) {
+    bool wifi = (type == TerminalTypeEnum::WiFiAp || type == TerminalTypeEnum::WiFiClient);
+    if (!wifi || ip.empty() || ip == "0.0.0.0") {
+        return {fit("Bit Pirate USB", kWidth), fit("", kWidth)};
+    }
+    return {fit("Bit Pirate WiFi", kWidth), fit(ip, kWidth)};
+}
+
+LcdScreen LcdScreenTransformer::adapter(const std::string& name) {
+    return {fit(name, kWidth), fit("", kWidth)};
+}
+
+std::vector<LcdScreen> LcdScreenTransformer::pinPages(const PinoutConfig& config) {
+    std::vector<LcdScreen> pages;
+    const auto pins = parsePins(config);
+    if (pins.empty()) return pages;
+
+    // 1-2 pins: mode + name + IO on line 1, GND + second pin on line 2.
+    if (pins.size() <= 2) {
+        auto cell = [](const Pin& p) { return fit(p.name, 4) + " IO" + p.number; };
+        std::string l1 = fit(config.getMode(), 5) + " " + fit(cell(pins[0]), 10);
+        std::string l2 = fit("GND", 6);
+        if (pins.size() == 2) l2 += cell(pins[1]);
+        pages.push_back({fit(l1, kWidth), fit(l2, kWidth)});
+        return pages;
+    }
+
+    for (size_t i = 0; i < pins.size(); i += 4) {
+        std::string l1, l2;
+        for (size_t k = 0; k < 4 && i + k < pins.size(); ++k) {
+            (k < 2 ? l1 : l2) += slot(pins[i + k]);
+        }
+        pages.push_back({fit(l1, kWidth), fit(l2, kWidth)});
+    }
+    return pages;
+}
diff --git a/src/Transformers/LcdScreenTransformer.h b/src/Transformers/LcdScreenTransformer.h
new file mode 100644
