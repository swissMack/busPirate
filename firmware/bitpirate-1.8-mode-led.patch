index e33aaa90..ec5f8b7c 100644
--- a/src/Boards/S3DevKit/S3DevKitBoard.h
+++ b/src/Boards/S3DevKit/S3DevKitBoard.h
@@ -2,7 +2,7 @@
 
 #ifdef DEVICE_S3DEVKIT
 
-#include "Boards/Common/Views/NoScreenDeviceView.h"
+#include "Boards/Common/Views/RgbLedView.h"
 #include "Boards/Common/Inputs/DefaultInput.h"
 #include "Boards/Common/Serial/BoardHostSerial.h"
 
@@ -15,7 +15,7 @@ public:
 
 private:
     BoardHostSerial hostSerial;
-    NoScreenDeviceView deviceView;
+    RgbLedView deviceView{LED_PIN};
     DefaultInput deviceInput;
 };
 
diff --git a/src/Shells/HelpShell.cpp b/src/Shells/HelpShell.cpp
index e42af478..a4fff3c6 100644
--- a/src/Shells/HelpShell.cpp
+++ b/src/Shells/HelpShell.cpp
@@ -115,6 +115,11 @@ void HelpShell::cmdGeneral() {
         "P                    - Enable pull-up",
         "p                    - Disable pull-up",
         "",
+#if defined(DEVICE_S3DEVKIT) && defined(LED_PIN) && LED_TYPE_RGB
+        "Board LED: off HIZ, blue I2C, green SPI,",
+        "  yellow UART/HDUART, cyan 1WIRE, white other",
+        "",
+#endif
         "Tip: use 'mode' (or 'm')."
     };
 
