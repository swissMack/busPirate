diff --git a/src/Status/ModeLed.cpp b/src/Status/ModeLed.cpp
new file mode 100644
index 0000000..431fa88
--- /dev/null
+++ b/src/Status/ModeLed.cpp
@@ -0,0 +1,30 @@
+#include "Status/ModeLed.h"
+
+#include <Arduino.h>
+
+#if defined(DEVICE_S3DEVKIT) && defined(LED_PIN) && LED_TYPE_RGB
+
+// Low on purpose: a WS2812 at full power is blinding on the desk.
+static constexpr uint8_t LEVEL = 24;
+
+void showModeLed(ModeEnum mode) {
+    uint8_t r = 0, g = 0, b = 0;
+    switch (mode) {
+        case ModeEnum::HIZ:
+        case ModeEnum::None:    break;                              // off
+        case ModeEnum::I2C:     b = LEVEL; break;                   // blue
+        case ModeEnum::SPI:     g = LEVEL; break;                   // green
+        case ModeEnum::UART:
+        case ModeEnum::HDUART:  r = LEVEL; g = LEVEL; break;        // yellow
+        case ModeEnum::OneWire: g = LEVEL; b = LEVEL; break;        // cyan
+        default:                r = g = b = LEVEL / 3; break;       // dim white
+    }
+    // The core's own RMT driver, not FastLED: LED mode owns FastLED.
+    rgbLedWrite(LED_PIN, r, g, b);
+}
+
+#else
+
+void showModeLed(ModeEnum) {}
+
+#endif
diff --git a/src/Status/ModeLed.h b/src/Status/ModeLed.h
new file mode 100644
index 0000000..3fa94e8
--- /dev/null
+++ b/src/Status/ModeLed.h
@@ -0,0 +1,7 @@
+#pragma once
+
+#include "Enums/ModeEnum.h"
+
+// Shows the current mode on the board's built-in RGB LED (S3 DevKit only).
+// HIZ is dark: every pin released. Does nothing on boards without one.
+void showModeLed(ModeEnum mode);
